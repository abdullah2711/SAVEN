# SAVEN worker->worktree map (load-bearing; copy to docs/agents/worker-map.env
# in the project repo and keep it updated — one entry per worker).
# The dispatcher updates this on EVERY assignment, verdict and merge.
# The black-box script REFUSES to push when a worker's contract and branch
# disagree (e.g. contract AUTH-006 with branch opencode/pivot-*).
WORKER_A_WT=/home/<user>/saven/wt-<worker-a-current-assignment>
WORKER_A_BRANCH=opencode/<worker-a-current-branch>
WORKER_A_CONTRACT=<CONTRACT-ID currently assigned to worker-a>
WORKER_B_WT=/home/<user>/saven/wt-<worker-b-current-assignment>
WORKER_B_BRANCH=opencode/<worker-b-current-branch>
WORKER_B_CONTRACT=<CONTRACT-ID currently assigned to worker-b>
