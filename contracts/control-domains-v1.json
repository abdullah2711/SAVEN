  "authorityAssertion": [
    "installationId",
    "tenantId",
    "companyId",
    "actorId",
    "sessionId",
    "commandVersion",
    "requestDigest",
    "permissionEpoch",
    "entitlementVersion",
    "ownerGeneration",
    "nodeAudience",
    "nonce",
    "issuedAt",
    "expiresAt",
    "signature"
