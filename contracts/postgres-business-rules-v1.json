  "approval_defaults": {
    "ai_origin_direct_post_allowed": false,
    "editable_in_pending": true,
    "requires_different_approver": false,
    "max_self_approval_amount": "0",
    "approval_threshold_amount": "0",
    "currency_required": true,
    "notes": "Defaults mirror the owner AI and approval constraints. Pending documents of any origin are editable by an authorized editor; the edit is audited, keeps original proposed values, and invalidates any prior approval. Approval of AI-origin documents uses the same approval_policy as human entries."
  },
  "posting_constraint_handlers": {
    "registered_in_this_contract": [],
    "note": "PIVOT-003 stores constraint data only. handler_key must resolve to a deterministic validator registered by PIVOT-013 and later posting contracts. No handler executes SQL or arbitrary JSON logic, and an unknown handler_key must fail closed at posting time.",
    "planned_examples": [
      "balanced_debits_credits",
      "period_not_locked",
      "account_requires_party",
      "withholding_reconciles_tax_schedule"
    ]
  },
