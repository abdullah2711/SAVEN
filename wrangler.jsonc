{
  "name": "saven-testing",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "build": {
    "command": "node scripts/deployment-guard.mjs && node scripts/check.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "testing",
    "API_MODE": "maintenance"
  },
  "observability": {
    "enabled": false
  },
  "vpc_services": [{"binding":"SAVEN_API","service_id":"01a1cd07-8d47-7bc0-a115-f8bf736614a2"}]
}
