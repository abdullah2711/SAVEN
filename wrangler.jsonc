{
  "name": "saven-testing",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "build": {
    "command": "node scripts/deployment-guard.mjs && node scripts/check.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "testing"
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saven-testing-db",
      "database_id": "42a1463c-40d9-4f23-9ecb-50265eb07bb1",
      "migrations_dir": "migrations"
    }
  ]
}
