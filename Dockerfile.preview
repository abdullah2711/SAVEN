FROM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
WORKDIR /app
ENV NODE_ENV=production PREVIEW_PORT=8792
COPY public ./public
COPY src/frontend-assets.mjs src/server-preview.mjs ./src/
COPY scripts/frontend-server.mjs ./scripts/
USER node
CMD ["node","scripts/frontend-server.mjs"]
